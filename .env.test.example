# ─────────────────────────────────────────────────────────────────────────────
# Ambiente de TESTE / DESENVOLVIMENTO LOCAL — copie para .env.test e ajuste
# NUNCA use o mesmo banco de produção
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados exclusivo para testes
DB_HOST=db
DB_PORT=3306
DB_DATABASE=appdb_test
DB_USERNAME=appuser
DB_PASSWORD=secret

# Credenciais admin do MySQL — para criar o banco de teste automaticamente
# Deixe em branco se DB_USERNAME já tiver permissão de CREATE DATABASE
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=root

# JWT
JWT_SECRET=test-jwt-secret-nao-use-em-producao
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Storage
# O bootstrap (tests/bootstrap.php) sobrescreve STORAGE_DRIVER=local antes de rodar
# seeds e servidor, então os testes automatizados nunca dependem do MinIO estar no ar.
# Para testar o fluxo S3 manualmente: troque para STORAGE_DRIVER=s3 e suba o MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads

# MinIO — S3-compatible para desenvolvimento local com S3
# Ativo apenas quando STORAGE_DRIVER=s3 acima
# Subir: docker compose up -d minio minio-init
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=onecheck-dev
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
S3_PRESIGNED_TTL=3600
# Ajuste a porta conforme exposição no host (ver docker-compose.yml)
S3_PRESIGNED_BASE_URL=http://localhost:9010

# Aplicação
APP_URL=http://localhost:8001
APP_ENV=test

# Geocodificação
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
