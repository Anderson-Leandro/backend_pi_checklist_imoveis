{
    "name": "one-check/api",
    "description": "One Check API — Sistema de vistoria de imóveis",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0",
        "ramsey/uuid": "^4.7",
        "spomky-labs/otphp": "^11.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
