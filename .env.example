# Banco de dados
DB_HOST=db
DB_PORT=3306
DB_DATABASE=appdb
DB_USERNAME=appuser
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# JWT
JWT_SECRET=mude-esta-chave-para-producao
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Armazenamento — driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads

# S3 — AWS real (produção)
# Preencher apenas quando STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=


# Endpoint interno: deixar vazio para AWS; usado apenas em ambientes com proxy S3-compatible
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# TTL em segundos das presigned URLs (padrão: 1 hora)
S3_PRESIGNED_TTL=3600
# Endpoint público para presigned URLs: deixar vazio para AWS real
# Preencher apenas quando o endpoint interno (AWS_ENDPOINT) difere do endereço público
S3_PRESIGNED_BASE_URL=

# Aplicação
APP_URL=http://localhost:8000
APP_ENV=development

# Geocodificação
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
