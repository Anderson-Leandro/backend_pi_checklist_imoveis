# Banco de dados
DB_HOST=db
DB_PORT=3306
DB_DATABASE=appdb
DB_USERNAME=appuser
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# JWT
JWT_SECRET=mude-esta-chave-para-producao
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Armazenamento
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=storage/uploads

# Aplicação
APP_URL=http://localhost:8000
APP_ENV=development

# Geocodificação
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
